{
  "Comment": "Data Ingestion and Bronze-to-Silver ETL Orchestration (dbt execution delegated to external workflow, triggered yearly by EventBridge)",
  "StartAt": "WHO",
  "States": {
    "WHO": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-who-lambda",
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 10, "MaxAttempts": 2, "BackoffRate": 2.0 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "Eurostat" }],
      "Next": "Eurostat"
    },
    "Eurostat": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-eurostat-lambda",
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 10, "MaxAttempts": 2, "BackoffRate": 2.0 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "ECDC" }],
      "Next": "ECDC"
    },
    "ECDC": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-ecdc-lambda",
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 10, "MaxAttempts": 2, "BackoffRate": 2.0 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "Run_OpenAQ_Parallel" }],
      "Next": "Run_OpenAQ_Parallel"
    },
    
    "Run_OpenAQ_Parallel": {
      "Type": "Parallel",
      "Comment": "Ingest all 9 OpenAQ groups concurrently.",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "End_Failure" }],
      "Branches": [
        { "StartAt": "OpenAQ_Group1", "States": { "OpenAQ_Group1": { "Type": "Task", "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-openaq-lambda", "Parameters": { "countries": ["AT","BE","BG"] }, "End": true } } },
        { "StartAt": "OpenAQ_Group2", "States": { "OpenAQ_Group2": { "Type": "Task", "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-openaq-lambda", "Parameters": { "countries": ["HR","CY","CZ"] }, "End": true } } },
        { "StartAt": "OpenAQ_Group3", "States": { "OpenAQ_Group3": { "Type": "Task", "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-openaq-lambda", "Parameters": { "countries": ["DK","EE","FI"] }, "End": true } } },
        { "StartAt": "OpenAQ_Group4", "States": { "OpenAQ_Group4": { "Type": "Task", "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-openaq-lambda", "Parameters": { "countries": ["FR","DE","GR"] }, "End": true } } },
        { "StartAt": "OpenAQ_Group5", "States": { "OpenAQ_Group5": { "Type": "Task", "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-openaq-lambda", "Parameters": { "countries": ["HU","IE","IT"] }, "End": true } } },
        { "StartAt": "OpenAQ_Group6", "States": { "OpenAQ_Group6": { "Type": "Task", "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-openaq-lambda", "Parameters": { "countries": ["LV","LT","LU"] }, "End": true } } },
        { "StartAt": "OpenAQ_Group7", "States": { "OpenAQ_Group7": { "Type": "Task", "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-openaq-lambda", "Parameters": { "countries": ["MT","NL","PL"] }, "End": true } } },
        { "StartAt": "OpenAQ_Group8", "States": { "OpenAQ_Group8": { "Type": "Task", "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-openaq-lambda", "Parameters": { "countries": ["PT","RO","SK"] }, "End": true } } },
        { "StartAt": "OpenAQ_Group9", "States": { "OpenAQ_Group9": { "Type": "Task", "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-openaq-lambda", "Parameters": { "countries": ["SI","ES","SE"] }, "End": true } } }
      ],
      "Next": "Start_Glue_Jobs_Parallel" 
    },

    "Start_Glue_Jobs_Parallel": {
      "Type": "Parallel",
      "Comment": "2. Run all Bronze-to-Silver ETL Jobs concurrently.",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "End_Failure" }],
      "Branches": [
        { "StartAt": "WHO_Job", "States": { "WHO_Job": { "Type": "Task", "Resource": "arn:aws:states:::glue:startJobRun.sync", "Parameters": { "JobName": "project-2-who-job" }, "End": true } } },
        { "StartAt": "ECDC_Job", "States": { "ECDC_Job": { "Type": "Task", "Resource": "arn:aws:states:::glue:startJobRun.sync", "Parameters": { "JobName": "project-2-ecdc-job" }, "End": true } } },
        { "StartAt": "Eurostat_Job", "States": { "Eurostat_Job": { "Type": "Task", "Resource": "arn:aws:states:::glue:startJobRun.sync", "Parameters": { "JobName": "project-2-eurostat-job" }, "End": true } } },
        { "StartAt": "OpenAQ_Job", "States": { "OpenAQ_Job": { "Type": "Task", "Resource": "arn:aws:states:::glue:startJobRun.sync", "Parameters": { "JobName": "project-2-openaq-job" }, "End": true } } }
      ],
      "Next": "Run_Silver_Crawlers_Parallel"
    },

    "Run_Silver_Crawlers_Parallel": {
      "Type": "Parallel",
      "Comment": "3. Run all Crawlers concurrently to update Silver metadata (for dbt/Athena).",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "End_Failure" }],
      "Branches": [
        { "StartAt": "WHO_Crawler", "States": { "WHO_Crawler": { "Type": "Task", "Resource": "arn:aws:states:::glue:startCrawlerRun.sync", "Parameters": { "Name": "crawler-who-silver" }, "End": true } } },
        { "StartAt": "ECDC_Crawler", "States": { "ECDC_Crawler": { "Type": "Task", "Resource": "arn:aws:states:::glue:startCrawlerRun.sync", "Parameters": { "Name": "crawler-ecdc-silver" }, "End": true } } },
        { "StartAt": "Eurostat_Crawler", "States": { "Eurostat_Crawler": { "Type": "Task", "Resource": "arn:aws:states:::glue:startCrawlerRun.sync", "Parameters": { "Name": "crawler-eurostat-silver" }, "End": true } } },
        { "StartAt": "OpenAQ_Crawler", "States": { "OpenAQ_Crawler": { "Type": "Task", "Resource": "arn:aws:states:::glue:startCrawlerRun.sync", "Parameters": { "Name": "crawler-openaq-silver" }, "End": true } } }
      ],
      "Next": "EndState"
    },
    
    "EndState": {
      "Type": "Succeed",
      "Comment": "Orchestration complete. Silver layer is ready. dbt transformation is triggered externally (e.g., GitHub Actions)."
    },
    "End_Failure": {
      "Type": "Fail",
      "Cause": "One or more critical ingestion or transformation steps failed."
    }
  }
}