{
  "Comment": "Sequential orchestration of Air Health Data Platform Lambdas with resilient error handling",
  "StartAt": "WHO",
  "States": {
    "WHO": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-who-lambda",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Eurostat"
        }
      ],
      "Next": "Eurostat"
    },
    "Eurostat": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-eurostat-lambda",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "ECDC"
        }
      ],
      "Next": "ECDC"
    },
    "ECDC": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-ecdc-lambda",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "OpenAQ_Group1"
        }
      ],
      "Next": "OpenAQ_Group1"
    },

    "OpenAQ_Group1": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-openaq-lambda",
      "Parameters": { "countries": ["AT","BE","BG"] },
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 10, "MaxAttempts": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "OpenAQ_Group2" }],
      "Next": "OpenAQ_Group2"
    },
    "OpenAQ_Group2": {
