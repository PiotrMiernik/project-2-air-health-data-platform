      "Parameters": { "countries": ["DK","EE","FI"] },
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 10, "MaxAttempts": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "OpenAQ_Group4" }],
      "Next": "OpenAQ_Group4"
    },
    "OpenAQ_Group4": {
