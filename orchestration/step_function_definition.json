{
  "Comment": "Sequential orchestration of Air Health Data Platform Lambdas with 4 OpenAQ groups",
  "StartAt": "OpenAQ_Group1",
  "States": {
    "OpenAQ_Group1": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-openaq-lambda",
      "Parameters": {
        "countries": ["AT", "BE", "BG", "HR", "CY", "CZ", "DK"]
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "OpenAQ_Group2"
    },
    "OpenAQ_Group2": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-openaq-lambda",
      "Parameters": {
        "countries": ["EE", "FI", "FR", "DE", "GR", "HU", "IE"]
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "OpenAQ_Group3"
    },
    "OpenAQ_Group3": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-openaq-lambda",
      "Parameters": {
        "countries": ["IT", "LV", "LT", "LU", "MT", "NL", "PL"]
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "OpenAQ_Group4"
    },
    "OpenAQ_Group4": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-openaq-lambda",
      "Parameters": {
        "countries": ["PT", "RO", "SK", "SI", "ES", "SE"]
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "WHO"
    },
    "WHO": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-who-lambda",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "Eurostat"
    },
    "Eurostat": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-eurostat-lambda",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "ECDC"
    },
    "ECDC": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-central-1:524501562188:function:project2-ecdc-lambda",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "End": true
    }
  }
}
